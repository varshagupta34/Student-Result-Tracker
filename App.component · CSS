* { box-sizing: border-box; margin: 0; padding: 0; }
 
body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: #f0f2f5;
  color: #1a1a1a;
}
 
.app {
  max-width: 1300px;
  margin: 0 auto;
  padding: 24px 20px;
}
 
/* Header */
.header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  color: white;
  padding: 24px 28px;
  border-radius: 16px;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.header-left { display: flex; align-items: center; gap: 16px; }
.logo { font-size: 36px; }
.header h1 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
.header p { font-size: 13px; color: #a8b2d8; }
 
/* Stats */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 16px;
}
.stat-card {
  background: white;
  border-radius: 12px;
  padding: 20px;
  border: 1px solid #e8ecf0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.stat-label { font-size: 12px; color: #888; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; }
.stat-value { font-size: 32px; font-weight: 800; }
.stat-value.blue { color: #4361ee; }
.stat-value.purple { color: #7209b7; }
.stat-value.green { color: #2a9d8f; }
.stat-value.red { color: #e63946; }
 
/* Top Banner */
.top-banner {
  background: linear-gradient(90deg, #ffd60a22, #ffd60a44);
  border: 1px solid #ffd60a88;
  color: #7a5c00;
  padding: 14px 20px;
  border-radius: 10px;
  margin-bottom: 16px;
  font-size: 14px;
}
 
/* Form */
.form-card {
  background: white;
  border-radius: 16px;
  padding: 28px;
  margin-bottom: 20px;
  border: 1px solid #e8ecf0;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
}
.form-card h2 { font-size: 18px; margin-bottom: 20px; color: #1a1a1a; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
.marks-section h3 { font-size: 14px; color: #555; margin-bottom: 12px; }
.marks-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin-bottom: 20px; }
.form-group { display: flex; flex-direction: column; gap: 5px; }
.form-group label { font-size: 12px; font-weight: 600; color: #555; text-transform: capitalize; }
.form-group input {
  padding: 10px 12px;
  border: 1.5px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
}
.form-group input:focus { border-color: #4361ee; }
.error-input { border-color: #e63946 !important; }
.error-msg { font-size: 11px; color: #e63946; }
.form-actions { display: flex; gap: 10px; justify-content: flex-end; }
 
/* Filters */
.filters-bar {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.search-input {
  padding: 10px 16px;
  border: 1.5px solid #ddd;
  border-radius: 10px;
  font-size: 14px;
  flex: 1;
  min-width: 220px;
  outline: none;
  background: white;
}
.search-input:focus { border-color: #4361ee; }
.grade-filters { display: flex; gap: 6px; flex-wrap: wrap; }
.filter-btn {
  padding: 8px 18px;
  border-radius: 20px;
  border: 1.5px solid #ddd;
  background: white;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  color: #555;
}
.filter-btn:hover { border-color: #4361ee; color: #4361ee; }
.filter-btn.active { background: #4361ee; color: white; border-color: #4361ee; }
 
.result-count { font-size: 13px; color: #888; margin-bottom: 12px; }
 
/* Table */
.table-wrapper {
  background: white;
  border-radius: 16px;
  border: 1px solid #e8ecf0;
  overflow: auto;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  margin-bottom: 20px;
}
table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 900px; }
thead tr { background: #f8f9fc; }
th {
  padding: 14px 14px;
  text-align: left;
  font-size: 11px;
  font-weight: 700;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  white-space: nowrap;
}
td { padding: 13px 14px; border-top: 1px solid #f0f2f5; color: #444; }
tr:hover td { background: #f8f9fc; }
.fail-row td { background: #fff8f8; }
.fail-row:hover td { background: #fff0f0; }
.roll-num { font-family: monospace; font-weight: 600; color: #4361ee; }
.student-name { font-weight: 600; color: #1a1a1a; white-space: nowrap; }
.low-mark { color: #e63946 !important; font-weight: 700; }
.no-data { text-align: center; color: #aaa; padding: 48px !important; font-size: 15px; }
 
/* Badges */
.grade-badge {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  min-width: 36px;
  text-align: center;
}
.grade-aplus { background: #e0f5f2; color: #085041; }
.grade-a { background: #eaf3de; color: #27500a; }
.grade-b { background: #faeeda; color: #633806; }
.grade-c { background: #e8ecfd; color: #3c3489; }
.grade-f { background: #fde8e9; color: #9b1c1c; }
 
.status-badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
}
.status-pass { background: #eaf3de; color: #27500a; }
.status-fail { background: #fde8e9; color: #9b1c1c; }
 
/* Buttons */
.btn-primary {
  padding: 11px 22px;
  background: #4361ee;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
  white-space: nowrap;
}
.btn-primary:hover { background: #3451d1; }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }
.btn-secondary {
  padding: 11px 22px;
  background: white;
  color: #1a1a1a;
  border: 1.5px solid #ddd;
  border-radius: 10px;
  font-size: 14px;
  cursor: pointer;
}
.btn-delete {
  padding: 5px 12px;
  background: #fde8e9;
  color: #e63946;
  border: none;
  border-radius: 6px;
  font-size: 12px;
  cursor: pointer;
  font-weight: 600;
  transition: background 0.2s;
}
.btn-delete:hover { background: #e63946; color: white; }
 
/* Footer */
.footer {
  text-align: center;
  font-size: 12px;
  color: #aaa;
  padding: 16px;
}
 
@media (max-width: 768px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .form-row { grid-template-columns: 1fr; }
  .marks-grid { grid-template-columns: repeat(2, 1fr); }
  .header { flex-direction: column; gap: 16px; align-items: flex-start; }
}
