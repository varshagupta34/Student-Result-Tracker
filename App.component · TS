
import { Component, OnInit } from '@angular/core';
import { FormBuilder, FormGroup, Validators } from '@angular/forms';
import { StudentService } from './student.service';
import { StudentResult } from './student.model';
 
@Component({
  selector: 'app-root',
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.css']
})
export class AppComponent implements OnInit {
  results: StudentResult[] = [];
  showForm = false;
  searchText = '';
  filterGrade = 'All';
  studentForm!: FormGroup;
  grades = ['All', 'A+', 'A', 'B', 'C', 'F'];
  subjects = ['english', 'math', 'science', 'social', 'telugu'];
 
  constructor(private studentService: StudentService, private fb: FormBuilder) {}
 
  ngOnInit(): void {
    this.loadResults();
    this.studentForm = this.fb.group({
      name: ['', [Validators.required, Validators.minLength(2)]],
      rollNumber: ['', Validators.required],
      english: [0, [Validators.required, Validators.min(0), Validators.max(100)]],
      math: [0, [Validators.required, Validators.min(0), Validators.max(100)]],
      science: [0, [Validators.required, Validators.min(0), Validators.max(100)]],
      social: [0, [Validators.required, Validators.min(0), Validators.max(100)]],
      telugu: [0, [Validators.required, Validators.min(0), Validators.max(100)]],
    });
  }
 
  loadResults(): void {
    this.results = this.studentService.getResults();
  }
 
  get filteredResults(): StudentResult[] {
    return this.results.filter(r => {
      const matchSearch = r.name.toLowerCase().includes(this.searchText.toLowerCase()) ||
                          r.rollNumber.toLowerCase().includes(this.searchText.toLowerCase());
      const matchGrade = this.filterGrade === 'All' || r.grade === this.filterGrade;
      return matchSearch && matchGrade;
    });
  }
 
  get classAverage(): number {
    if (!this.results.length) return 0;
    return this.results.reduce((sum, r) => sum + r.percentage, 0) / this.results.length;
  }
 
  get passCount(): number { return this.results.filter(r => r.status !== 'Fail').length; }
  get failCount(): number { return this.results.filter(r => r.status === 'Fail').length; }
 
  get topStudent(): StudentResult | null {
    return this.results.length ? this.results.reduce((a, b) => a.percentage > b.percentage ? a : b) : null;
  }
 
  onSubmit(): void {
    if (this.studentForm.valid) {
      this.studentService.addStudent({ id: 0, ...this.studentForm.value });
      this.loadResults();
      this.studentForm.reset({ english: 0, math: 0, science: 0, social: 0, telugu: 0 });
      this.showForm = false;
    }
  }
 
  deleteStudent(id: number): void {
    if (confirm('Are you sure you want to delete this student?')) {
      this.studentService.deleteStudent(id);
      this.loadResults();
    }
  }
 
  getGradeClass(grade: string): string {
    const map: { [key: string]: string } = {
      'A+': 'grade-aplus', 'A': 'grade-a', 'B': 'grade-b', 'C': 'grade-c', 'F': 'grade-f'
    };
    return map[grade] || '';
  }
 
  getStatusClass(status: string): string {
    return status === 'Fail' ? 'status-fail' : 'status-pass';
  }
 
  isFieldInvalid(field: string): boolean {
    const control = this.studentForm.get(field);
    return !!(control && control.invalid && control.touched);
  }
}
 
